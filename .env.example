# ── AI Video Assistant — Environment Variables ──

# Groq API Key (Used for ultra-fast Whisper transcription & fast LLM inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Mistral AI API Key (Used as alternative LLM for Summarization, Extraction, and RAG Q&A)
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Used for Hindi / Hinglish Speech-to-Text)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# OpenAI Whisper local model size (tiny, base, small, medium, large - used as fallback)
WHISPER_MODEL=small
