# ── AI Video Assistant — Environment Variables ──

# Mistral AI API Key (Used for Summarization, Extraction, and RAG Q&A)
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Used for Hindi / Hinglish Speech-to-Text)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# OpenAI Whisper local model size (tiny, base, small, medium, large)
WHISPER_MODEL=small
